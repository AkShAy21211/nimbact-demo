{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:category(salon|boutique|bakery|restaurant|clinic|gym|photography|furniture|homestay|taxi|driving|coaching|mobile|auto)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ]
}
